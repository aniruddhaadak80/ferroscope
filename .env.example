# Ferroscope runs with zero keys. Every value here is optional.
# Never commit real secrets. Use {env:NAME} or {file:path} substitution in tooling.

# Deterministic seed for the cascade simulator and generated datasets.
NEXT_PUBLIC_SIM_SEED=2718

# Public site origin, used for canonical URLs and OG images.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: live incident adapter (disabled by default; the app is fully offline).
# FERROSCOPE_FEED_URL=

# Optional: analyst service (Python). The web app degrades gracefully when absent.
# ANALYST_SERVICE_URL=http://127.0.0.1:8787

# Optional: SSE relay (Go).
# RELAY_SERVICE_URL=http://127.0.0.1:8788
