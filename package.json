{
  "name": "ferroscope",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Map your blast radius before the breach does.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "typecheck": "turbo run typecheck && tsc --noEmit -p tsconfig.e2e.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "turbo run test",
    "test:e2e": "playwright test",
    "loc": "bun scripts/loc-count.mjs",
    "assets": "bun scripts/gen-assets.mjs",
    "check:css": "bun scripts/check-css.mjs",
    "verify": "bun run typecheck && bun run lint && bun run test && bun run build && bun run check:css",
    "ci": "bun run verify"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "^2.0.6",
    "@playwright/test": "^1.57.0",
    "@types/node": "^26.6.5",
    "turbo": "^2.5.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.2.0",
    "node": ">=22"
  }
}
