  INCIDENT {
    string slug PK
    string name
    string severity
    float cvss
    string vector
    string disclosedAt
    string[] regions
    string[] affected
    string[] mitigations
  }
  INCIDENT_MATCH {
    boolean matched
    float confidence
    string effectiveSeverity
    int contribution
  }
  EXPOSURE_REPORT {
    int risk
    int score
    string band
    int examinedStack
  }
  REMEDIATION_ACTION {
    string id PK
    int minutes
    float reduces
    string category
  }
  ACTION_PLAN {
    int riskReduced
    float efficiency
    boolean completed
  }
